# Copy to .env and fill in. Never share this file. Never paste these values into chat.
TIMEZONE=America/New_York           # IANA name, e.g. America/Los_Angeles, Europe/London
CALORIE_GOAL=2200
PROTEIN_GOAL=150
STEPS_GOAL=10000
ACTIVE_KCAL_GOAL=500

# Google (your own OAuth client; README step 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN and SHEET_ID are written for you by the scripts.

# Oura (your own developer app; README step 3)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:8080/callback

# Cloudflare (README step 4)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ALLOWED_EMAIL=you@example.com       # the ONLY email that can open the app
WORKER_NAME=heroarc
# WORKERS_SUBDOMAIN=pick-a-unique-name   # only if Cloudflare says you have no workers.dev subdomain yet
